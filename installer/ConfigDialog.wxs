<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Custom PinShare Configuration Dialog -->
  <Fragment>
    <UI Id="PinShareConfigUI">

      <!-- PinShare Configuration Dialog -->
      <Dialog Id="PinShareConfigDlg" Width="370" Height="270" Title="[ProductName] Configuration">
        <!-- Banner -->
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <!-- Title -->
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Configuration" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Configure PinShare for your organization." />

        <!-- Organization Name -->
        <Control Id="OrgNameLabel" Type="Text" X="20" Y="60" Width="100" Height="15" Text="Organization Name:" />
        <Control Id="OrgNameEdit" Type="Edit" X="125" Y="58" Width="220" Height="18" Property="ORG_NAME" />

        <!-- Group Name -->
        <Control Id="GroupNameLabel" Type="Text" X="20" Y="85" Width="100" Height="15" Text="Group Name:" />
        <Control Id="GroupNameEdit" Type="Edit" X="125" Y="83" Width="220" Height="18" Property="GROUP_NAME" />

        <!-- UI Port -->
        <Control Id="UIPortLabel" Type="Text" X="20" Y="115" Width="50" Height="15" Text="UI Port:" />
        <Control Id="UIPortEdit" Type="Edit" X="75" Y="113" Width="50" Height="18" Property="UI_PORT" />

        <!-- API Port -->
        <Control Id="APIPortLabel" Type="Text" X="140" Y="115" Width="50" Height="15" Text="API Port:" />
        <Control Id="APIPortEdit" Type="Edit" X="195" Y="113" Width="50" Height="18" Property="PINSHARE_API_PORT" />

        <!-- P2P Port -->
        <Control Id="P2PPortLabel" Type="Text" X="260" Y="115" Width="50" Height="15" Text="P2P Port:" />
        <Control Id="P2PPortEdit" Type="Edit" X="295" Y="113" Width="50" Height="18" Property="PINSHARE_P2P_PORT" />

        <!-- Skip VirusTotal checkbox -->
        <Control Id="SkipVTCheck" Type="CheckBox" X="20" Y="145" Width="320" Height="17" Property="SKIP_VIRUSTOTAL" CheckBoxValue="1" Text="Skip VirusTotal scanning (for private/air-gapped networks)" />

        <!-- Enable Cache checkbox -->
        <Control Id="CacheCheck" Type="CheckBox" X="20" Y="165" Width="150" Height="17" Property="ENABLE_CACHE" CheckBoxValue="1" Text="Enable file caching" />

        <!-- Archive Node checkbox -->
        <Control Id="ArchiveCheck" Type="CheckBox" X="180" Y="165" Width="180" Height="17" Property="ARCHIVE_NODE" CheckBoxValue="1" Text="Run as archive node" />

        <!-- Start service after install -->
        <Control Id="StartServiceCheck" Type="CheckBox" X="20" Y="190" Width="200" Height="17" Property="START_SERVICE_NOW" CheckBoxValue="1" Text="Start service after install" />

        <!-- Start tray after install -->
        <Control Id="StartTrayCheck" Type="CheckBox" X="220" Y="190" Width="140" Height="17" Property="START_TRAY_NOW" CheckBoxValue="1" Text="Start tray app" />

        <!-- Navigation buttons -->
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Insert our dialog after InstallDirDlg in the sequence -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="PinShareConfigDlg" Order="5" Condition="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="PinShareConfigDlg" Order="5" Condition="NOT Installed" />

    </UI>
  </Fragment>

</Wix>
