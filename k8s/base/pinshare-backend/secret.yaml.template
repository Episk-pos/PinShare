apiVersion: v1
kind: Secret
metadata:
  name: pinshare-backend-secret
  namespace: pinshare
  labels:
    app: pinshare-backend
type: Opaque
stringData:
  # VirusTotal API token (optional)
  VT_TOKEN: ""

  # Google OAuth credentials (optional, for Google Drive import)
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""

  # Encryption key for OAuth tokens (required if using Google Drive import)
  # Must be exactly 32 bytes
  PS_ENCRYPTION_KEY: ""
