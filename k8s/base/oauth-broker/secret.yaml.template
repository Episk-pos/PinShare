apiVersion: v1
kind: Secret
metadata:
  name: oauth-broker-secret
  namespace: pinshare
  labels:
    app: oauth-broker
type: Opaque
stringData:
  # Google OAuth credentials (required)
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""

  # OAuth redirect URL
  REDIRECT_URL: "http://localhost:8888/callback"

  # Server port
  PORT: "8888"
