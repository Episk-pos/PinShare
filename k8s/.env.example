# PinShare Kubernetes Secrets Template
# Copy this file and fill in your actual values, then create secrets using kubectl

# ============================================================================
# Backend Secrets
# ============================================================================

# VirusTotal API Token (optional)
# Get your token from: https://www.virustotal.com/gui/my-apikey
VT_TOKEN=

# Google OAuth Credentials (optional, for Google Drive import feature)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption Key for OAuth Tokens (required if using Google Drive import)
# Must be exactly 32 bytes (base64 encoded)
# Generate with: openssl rand -base64 32
PS_ENCRYPTION_KEY=

# ============================================================================
# OAuth Broker Secrets
# ============================================================================

# Google OAuth Credentials (required for OAuth Broker service)
OAUTH_BROKER_GOOGLE_CLIENT_ID=
OAUTH_BROKER_GOOGLE_CLIENT_SECRET=

# OAuth Redirect URL (adjust if using different port or domain)
REDIRECT_URL=http://localhost:8888/callback

# OAuth Broker Port
PORT=8888

# ============================================================================
# Creating Secrets in Kubernetes
# ============================================================================

# After filling in the values above, create the secrets using these commands:

# 1. Create the pinshare namespace (if not already created)
# kubectl create namespace pinshare

# 2. Create backend secrets
# kubectl create secret generic pinshare-backend-secret \
#   --from-literal=VT_TOKEN="${VT_TOKEN}" \
#   --from-literal=GOOGLE_CLIENT_ID="${GOOGLE_CLIENT_ID}" \
#   --from-literal=GOOGLE_CLIENT_SECRET="${GOOGLE_CLIENT_SECRET}" \
#   --from-literal=PS_ENCRYPTION_KEY="${PS_ENCRYPTION_KEY}" \
#   -n pinshare

# 3. Create OAuth broker secrets
# kubectl create secret generic oauth-broker-secret \
#   --from-literal=GOOGLE_CLIENT_ID="${OAUTH_BROKER_GOOGLE_CLIENT_ID}" \
#   --from-literal=GOOGLE_CLIENT_SECRET="${OAUTH_BROKER_GOOGLE_CLIENT_SECRET}" \
#   --from-literal=REDIRECT_URL="${REDIRECT_URL}" \
#   --from-literal=PORT="${PORT}" \
#   -n pinshare

# ============================================================================
# Updating Secrets
# ============================================================================

# To update a secret, delete and recreate it:
# kubectl delete secret pinshare-backend-secret -n pinshare
# kubectl create secret generic pinshare-backend-secret ... (as above)
# kubectl rollout restart deployment/pinshare-backend -n pinshare

# Or patch it:
# kubectl patch secret pinshare-backend-secret -n pinshare \
#   -p='{"stringData":{"VT_TOKEN":"new-value"}}'
# kubectl rollout restart deployment/pinshare-backend -n pinshare
