# PinShare Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# Core PinShare Settings
# =============================================================================

# Organization and Group Name (used for P2P topic routing)
PS_ORGNAME=Cypherpunk
PS_GROUPNAME=TestLab

# libp2p Port
PS_LIBP2P_PORT=50001

# File Management
PS_UPLOAD_FOLDER=./upload
PS_CACHE_FOLDER=./cache
PS_REJECT_FOLDER=./rejected
PS_METADATA_FILE=metadata.json
PS_IDENTITY_KEY_FILE=identity.key

# Feature Flags
PS_FF_ARCHIVE_NODE=false
PS_FF_CACHE=false
PS_FF_MOVE_UPLOAD=false
PS_FF_SENDFILE_VT=false
PS_FF_SKIP_VT=false
PS_FF_IGNORE_UPLOADS_IN_METADATA=true

# =============================================================================
# Security Settings
# =============================================================================

# VirusTotal API Token (optional, for security scanning)
# Get your API key from: https://www.virustotal.com/gui/my-apikey
VT_TOKEN=YOUR_VIRUSTOTAL_TOKEN_HERE

# =============================================================================
# Google Drive Import Settings
# =============================================================================

# Database file for import job tracking
PS_DATABASE_FILE=pinshare.db

# Temporary download directory for Google Drive files
PS_TEMP_DOWNLOAD_DIR=./tmp/gdrive

# Maximum concurrent import jobs
PS_MAX_CONCURRENT_JOBS=3

# Maximum file size in MB (0 = unlimited)
PS_MAX_FILE_SIZE_MB=1024

# Encryption key for OAuth token storage (MUST be exactly 32 bytes)
# Generate with: openssl rand -base64 32
PS_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Google OAuth 2.0 Credentials
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:9090/api/google-drive/callback

# =============================================================================
# Notes
# =============================================================================

# To enable Google Drive import:
# 1. Create a Google Cloud Project at https://console.cloud.google.com
# 2. Enable the Google Drive API
# 3. Create OAuth 2.0 credentials (Web application type)
# 4. Add authorized redirect URI: http://localhost:9090/api/google-drive/callback
# 5. Copy the Client ID and Client Secret to this file
# 6. Generate a secure 32-byte encryption key for token storage

# Security Capability Levels (auto-detected):
# 1 = P2P-Sec service (localhost:36939)
# 2 = VirusTotal API (requires VT_TOKEN)
# 3 = ClamAV (requires clamscan)
# 4 = VirusTotal Web Scraping (requires Chromium browser)
