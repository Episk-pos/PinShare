{
  "name": "pinshare-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "config": {
    "cloudfrontId": "E1N441DRNZRMQ4",
    "s3Bucket": "share.episkopos.community"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "deploy:s3": "npm run build && aws s3 sync dist/ s3://$npm_package_config_s3Bucket --delete",
    "deploy:uncache": "aws cloudfront create-invalidation --distribution-id $npm_package_config_cloudfrontId --paths '/*'",
    "deploy": "npm run deploy:s3 && npm run deploy:uncache"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.25.4",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "http-proxy-middleware": "^3.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.1"
  }
}
