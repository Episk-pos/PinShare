# Production Environment Variables
# These are baked into the build at build-time

# PinShare Backend API URL
VITE_API_BASE=https://psbackend.episkopos.community

# IPFS Gateway URL
VITE_GATEWAY_BASE=https://ipfs.episkopos.community/ipfs

# IPFS API endpoint
VITE_IPFS_API_BASE=https://ipfs.episkopos.community/api/v0

# OAuth Broker URL
VITE_OAUTH_BASE=https://oauth.episkopos.community
